{
  "version": 2,
  "builds": [
    {
      "src": "api/mcp.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/auto-claim.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/mcp",
      "dest": "/api/mcp.ts"
    },
    {
      "src": "/api/auto-claim",
      "dest": "/api/auto-claim.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/auto-claim",
      "schedule": "5 0 * * *"
    }
  ]
}
